{
  "name": "blindbox-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build && concurrently -n vite,api -c cyan,magenta \"vite\" \"npm:dev:api\"",
    "dev:api": "wrangler pages dev ./dist --port 8788 --persist-to ./.wrangler/state",
    "build": "tsc -b --noEmit && vite build",
    "preview": "npm run build && wrangler pages dev ./dist --port 8788 --persist-to ./.wrangler/state",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "db:migrate": "wrangler d1 migrations apply blindbox-dashboard --local --persist-to ./.wrangler/state",
    "db:reset": "rm -rf ./.wrangler/state && npm run db:migrate",
    "seed": "npm run db:migrate && tsx scripts/seed.ts",
    "deploy": "npm run build && wrangler pages deploy ./dist",
    "db:migrate:remote": "wrangler d1 migrations apply blindbox-dashboard --remote"
  },
  "dependencies": {
    "papaparse": "^5.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}
